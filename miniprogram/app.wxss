/* ========== 设计 Token（来源：design-spec.md V2.8） ========== */
page {
  /* Core Colors */
  --color-white: #FFFFFF;
  --color-black: #000000;
  --color-brand: #E31E15;
  --color-brand-light: #F36F59;
  --color-gray-light: #D9D9D9;
  --color-gray-mid: #AAAAAA;
  --color-gray-slate: #94A3B8;
  --color-gray-dark: #333333;
  --color-text-dark: #252525;
  --color-cta-dark: #1E1E1E;
  --color-cancel-bg: #F5F5F5;

  /* Five Lions */
  --color-fire: #E31E15;
  --color-water: #5AB8E8;
  --color-gold: #D9A441;
  --color-wood: #65B96A;
  --color-earth: #9A6A3E;

  /* States */
  --color-success: #34C759;
  --color-warning: #FFB020;
  --color-error: #FF4D4F;
  --color-disabled: #C9CDD4;

  /* Spacing (rpx: 1px = 2rpx) */
  --page-margin: 40rpx;
  --content-width: 670rpx;
  --card-gap: 30rpx;
  --section-gap: 40rpx;

  /* Radius */
  --radius-card: 32rpx;
  --radius-btn: 16rpx;
  --radius-tag: 16rpx;
  --radius-pill: 999rpx;

  /* Shadows */
  --shadow-card: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  --shadow-hero: 0 16rpx 48rpx rgba(227, 30, 21, 0.12);

  /* Font (design-spec §3.2) */
  --font-hero-en: 76rpx;
  --font-hero-title: 60rpx;
  --font-page-title: 40rpx;
  --font-sub-title: 32rpx;
  --font-card-sub: 24rpx;
  --font-cta: 24rpx;
  --font-tab: 24rpx;

  /* Layout */
  --bottom-nav-height: 132rpx;
  --status-bar-height: 88rpx;

  /* 页面底色 */
  margin: 0;
  padding: 0;
  background-color: #FFFFFF;
  font-family: "MiSans Latin", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #000000;
  box-sizing: border-box;
}

/* ========== 状态栏组件 ========== */
.status-bar {
  width: 100%;
  height: var(--status-bar-height);
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 30;
  background: #1E1E1E;
}

/* ========== 返回按钮（全局统一） ========== */
.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #AAAAAA;
  background: transparent;
}
.back-btn:active {
  background: #f0f0f0;
}
.back-btn-dark {
  color: #FFFFFF;
}

/* ========== 底部导航栏 ========== */
.bottom-nav-placeholder {
  height: var(--bottom-nav-height);
}

/* ========== Hero 卡片 ========== */
.hero-card {
  width: 670rpx;
  height: 404rpx;
  border-radius: 32rpx;
  margin: 0 40rpx;
  overflow: hidden;
  position: relative;
}

/* ========== 次级功能卡片 ========== */
.secondary-card {
  width: 320rpx;
  height: 242rpx;
  border-radius: 32rpx;
  background: #F36F59;
  position: relative;
  overflow: hidden;
}

/* ========== CTA 按钮 ========== */
.hero-cta {
  display: flex;
  align-items: center;
  width: 292rpx;
  height: 62rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 24rpx;
}
.hero-cta-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}
.hero-cta-play {
  width: 28rpx;
  height: 28rpx;
  background: #E31E15;
  border-radius: 50%;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-cta-play::after {
  content: '';
  width: 0;
  height: 0;
  border-left: 10rpx solid #1E1E1E;
  border-top: 7rpx solid transparent;
  border-bottom: 7rpx solid transparent;
  margin-left: 2rpx;
}

/* ========== 弹窗 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.35);
  z-index: 100;
}
.modal-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 640rpx;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
}
.modal-drag {
  width: 80rpx;
  height: 8rpx;
  background: #D9D9D9;
  border-radius: 4rpx;
  margin: 16rpx auto 0;
}
.modal-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #000000;
  text-align: center;
  margin-top: 48rpx;
}
.modal-sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #94A3B8;
  text-align: center;
  margin-top: 12rpx;
}
.modal-cancel {
  width: 670rpx;
  height: 88rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 52rpx 40rpx 0;
}
.modal-cancel-text {
  font-size: 32rpx;
  font-weight: 400;
  color: #AAAAAA;
}

/* ========== Toast ========== */
.toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #333333;
  color: #FFFFFF;
  font-size: 26rpx;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  z-index: 200;
}

/* ========== 工具类 ========== */
.flex-row {
  display: flex;
  flex-direction: row;
}
.flex-col {
  display: flex;
  flex-direction: column;
}
.items-center {
  align-items: center;
}
.justify-center {
  justify-content: center;
}
.text-center {
  text-align: center;
}

/* ===== 骨架屏 ===== */
@keyframes skeletonPulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.6; }
}
.skeleton-box {
  background: #E8E8E8;
  border-radius: 16rpx;
  animation: skeletonPulse 1.5s ease-in-out infinite;
}
.skeleton-row {
  height: 32rpx;
  margin-bottom: 16rpx;
  background: #E8E8E8;
  border-radius: 8rpx;
  animation: skeletonPulse 1.5s ease-in-out infinite;
}
.skeleton-card {
  width: 100%;
  height: 180rpx;
  background: #E8E8E8;
  border-radius: 24rpx;
  animation: skeletonPulse 1.5s ease-in-out infinite;
}
.skeleton-circle {
  border-radius: 50%;
  background: #E8E8E8;
  animation: skeletonPulse 1.5s ease-in-out infinite;
}

/* ===== 全局错误页 ===== */
.error-full {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 32rpx;
}
.error-full-icon {
  font-size: 96rpx;
  color: #C9CDD4;
}
.error-full-text {
  font-size: 28rpx;
  color: #94A3B8;
  text-align: center;
  line-height: 1.6;
}
.error-full-btn {
  width: 320rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #E31E15;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 加载超时弹窗 ===== */
.timeout-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  z-index: 300;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
}
.timeout-modal-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}
.timeout-modal-text {
  font-size: 28rpx;
  color: #666666;
  display: block;
  margin-bottom: 40rpx;
  line-height: 1.6;
}
.timeout-modal-row {
  display: flex;
  gap: 24rpx;
  justify-content: center;
}
.timeout-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.timeout-btn-retry {
  background: #E31E15;
  color: #FFFFFF;
}
.timeout-btn-home {
  background: #F5F5F5;
  color: #AAAAAA;
}
