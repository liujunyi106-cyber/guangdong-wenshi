<!-- 个人中心 -->
<view class="page">

  <!-- 状态栏 -->
  <view class="status-bar" style="height:{{statusBarHeight}}px; padding-top:{{statusBarPadding}}px;"></view>

  <scroll-view scroll-y class="page-scroll" scroll-top="{{scrollTop}}" style="padding-top:{{statusBarHeight}}px;">

    <!-- 用户卡片（对齐商店 Hero 卡片 335×142） -->
    <view class="hero-card">
      <image class="hero-dots" src="/images/mine-hero-dots.svg" mode="aspectFit"></image>
      <view class="hero-avatar-wrap">
        <image class="hero-avatar" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}"></image>
        <image wx:else class="hero-avatar-default" src="/images/icon-mine-avatar.png" mode="aspectFit"></image>
      </view>
      <view class="hero-name-wrap">
        <text class="hero-name">小狮子</text>
        <text class="hero-id">ID: {{userId || 'LION0001'}}</text>
      </view>
    </view>

    <!-- ===== 小狮收集 ===== -->
    <view class="card">
      <view class="card-head">
        <image class="card-head-icon" src="/images/icon-collect.png" mode="aspectFit"></image>
        <text class="card-title">我的小狮</text>
        <text class="card-badge">{{unlockedCount}}/5</text>
      </view>
      <view class="card-sub" wx:if="{{title}}">{{title}}</view>
      <view class="lion-row">
        <view class="lion-card {{item.unlocked ? '' : 'lion-locked'}}" wx:for="{{lions}}" wx:key="id">
          <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" class="lion-img"></image>
          <text wx:else class="lion-emoji">{{item.emoji}}</text>
          <text class="lion-name">{{item.name}}</text>
          <image wx:if="{{!item.unlocked}}" src="/images/lock-3d.png" mode="aspectFit" class="lion-lock-icon"></image>
        </view>
      </view>
      <view class="lion-progress">
        <view class="lion-progress-fill" style="width:{{(unlockedCount/5)*100}}%;"></view>
      </view>
    </view>

    <!-- ===== 成就 ===== -->
    <view class="card">
      <view class="card-head">
        <image class="card-head-icon" src="/images/icon-achievement.png" mode="aspectFit"></image>
        <text class="card-title">我的成就</text>
      </view>
      <scroll-view scroll-x class="achi-scroll">
        <view class="achi-row">
          <view class="achi-card {{item.locked ? 'achi-locked' : ''}}" wx:for="{{achievements}}" wx:key="id"
            bindtap="onAchievementTap" data-locked="{{item.locked}}" data-desc="{{item.desc}}" data-name="{{item.name}}">
            <image class="achi-card-confetti" src="/images/confetti.png" mode="aspectFill" wx:if="{{!item.locked}}"></image>
            <image class="achi-icon-img" src="{{item.icon}}" mode="aspectFit"></image>
            <text class="achi-name">{{item.name}}</text>
            <text class="achi-desc">{{item.locked ? '未解锁' : item.desc}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ===== 我的作品 ===== -->
    <view class="card">
      <view class="card-head">
        <image class="card-head-icon" src="/images/icon-color.png" mode="aspectFit"></image>
        <text class="card-title">我的作品</text>
      </view>
      <view wx:if="{{works.length === 0}}" class="empty-hint">
        <text class="empty-text">还没有作品，去创作吧~</text>
      </view>
      <scroll-view wx:elif="{{works.length >= 4}}" scroll-x class="work-scroll">
        <view class="work-row-scroll">
          <view class="work-card" wx:for="{{works}}" wx:key="time" bindtap="onWorkTap" data-index="{{index}}">
            <image wx:if="{{item.imageUrl}}" class="work-card-img" src="{{item.imageUrl}}" mode="aspectFill"></image>
            <text wx:else class="work-card-placeholder">🎨</text>
          </view>
        </view>
      </scroll-view>
      <view wx:else class="work-row-fixed">
        <view class="work-card" wx:for="{{works}}" wx:key="time" bindtap="onWorkTap" data-index="{{index}}">
          <image wx:if="{{item.imageUrl}}" class="work-card-img" src="{{item.imageUrl}}" mode="aspectFill"></image>
          <text wx:else class="work-card-placeholder">🎨</text>
        </view>
      </view>
    </view>

    <!-- 作品弹窗 -->
    <view class="work-modal-overlay" wx:if="{{workModalShow}}" bindtap="onWorkClose">
      <view class="work-modal-card" catchtap="">
        <image wx:if="{{currentWork.imageUrl}}" class="work-modal-img" src="{{currentWork.imageUrl}}" mode="aspectFit"></image>
        <text wx:else class="work-modal-placeholder">🎨</text>
        <view class="work-modal-actions">
          <view class="work-modal-btn work-modal-btn-delete" bindtap="onWorkDelete">删除</view>
          <view class="work-modal-btn work-modal-btn-share" bindtap="onWorkShare">分享</view>
        </view>
      </view>
    </view>

    <!-- ===== 下拉展开式菜单 ===== -->
    <view class="card menu-accordion-card">
      <!-- 敲鼓成绩 -->
      <view class="accordion-item">
        <view class="accordion-header" bindtap="onToggleAccordion" data-key="drum">
          <view class="menu-left">
            <image class="menu-icon-img" src="/images/icon-drum-record.png" mode="aspectFit"></image>
            <text class="menu-label">敲鼓成绩</text>
          </view>
          <text class="accordion-arrow {{expanded.drum ? 'open' : ''}}">›</text>
        </view>
        <view class="accordion-body" wx:if="{{expanded.drum}}">
          <view wx:if="{{drumRecords.length === 0}}" class="empty-hint">
            <text class="empty-text">还没有敲鼓记录，去首页挑战吧~</text>
          </view>
          <view class="record-item" wx:for="{{drumRecords}}" wx:key="time">
            <view class="record-main">
              <view class="record-head">
                <text class="record-rating">{{item.rating}}</text>
                <text class="record-score">{{item.score}} 分</text>
              </view>
              <view class="record-stats">
                <text class="stat">P<text class="stat-num">{{item.perfect}}</text></text>
                <text class="stat">G<text class="stat-num">{{item.good}}</text></text>
                <text class="stat">E<text class="stat-num">{{item.early}}</text></text>
                <text class="stat">M<text class="stat-num">{{item.miss}}</text></text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="menu-divider"></view>

      <!-- AR 照片 -->
      <view class="accordion-item">
        <view class="accordion-header" bindtap="onToggleAccordion" data-key="photo">
          <view class="menu-left">
            <image class="menu-icon-img" src="/images/icon-ar-record.png" mode="aspectFit"></image>
            <text class="menu-label">AR 照片</text>
          </view>
          <text class="accordion-arrow {{expanded.photo ? 'open' : ''}}">›</text>
        </view>
        <view class="accordion-body" wx:if="{{expanded.photo}}">
          <view wx:if="{{photoRecords.length === 0}}" class="empty-hint">
            <text class="empty-text">还没有 AR 照片，去拍照吧~</text>
          </view>
          <view class="photo-grid">
            <view class="photo-thumb" wx:for="{{photoRecords}}" wx:key="time">
              <text class="photo-thumb-emoji">🦁</text>
              <text class="photo-thumb-name">{{item.stickerName}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="menu-divider"></view>

      <!-- 我的订单 -->
      <view class="accordion-item">
        <view class="accordion-header" bindtap="onToggleAccordion" data-key="orders">
          <view class="menu-left">
            <image class="menu-icon-img" src="/images/icon-order.png" mode="aspectFit"></image>
            <text class="menu-label">我的订单</text>
          </view>
          <text class="accordion-arrow {{expanded.orders ? 'open' : ''}}">›</text>
        </view>
        <view class="accordion-body" wx:if="{{expanded.orders}}">
          <view class="empty-hint">
            <text class="empty-text">暂无订单（商品详情页开发中）</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>

  </scroll-view>
</view>
