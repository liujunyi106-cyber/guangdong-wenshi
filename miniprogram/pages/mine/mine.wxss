/* 个人中心样式 */

.page {
  height: 100vh;
  background: #FFFFFF;
}

/* 用户头像区 */
.profile-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}
.avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #F5F5F5;
  margin-bottom: 24rpx;
}
.avatar {
  width: 100%;
  height: 100%;
}
.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  background: #F36F59;
}
.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
}

/* 区域标题 */
.section-header {
  padding: 32rpx 40rpx 16rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #252525;
}

/* 小狮收藏 */
.lion-collection {
  display: flex;
  gap: 24rpx;
  padding: 0 40rpx;
  flex-wrap: wrap;
}
.lion-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  position: relative;
}
.lion-item.lion-locked {
  opacity: 0.5;
}
.lion-img {
  width: 100rpx;
  height: 100rpx;
}
.lion-emoji {
  font-size: 56rpx;
}
.lion-name {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}
.lion-lock {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 48rpx;
  height: 48rpx;
}

/* 成就 */
.achievement-list {
  padding: 0 40rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.achi-item {
  width: 210rpx;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  text-align: center;
}
.achi-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 8rpx;
}
.achi-name {
  font-size: 24rpx;
  color: #333333;
  font-weight: 600;
  display: block;
}
.achi-desc {
  font-size: 20rpx;
  color: #949494;
  display: block;
  margin-top: 4rpx;
}

/* 作品 */
.work-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 40rpx;
}
.work-item {
  width: 210rpx;
  height: 210rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.work-placeholder {
  font-size: 48rpx;
  color: #CCCCCC;
}
.empty-text {
  padding: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #AAAAAA;
}

.bottom-nav-placeholder {
  height: 132rpx;
}
