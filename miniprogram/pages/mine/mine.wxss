/* 个人中心 - 视觉重塑 */

.page {
  height: 100vh;
  background: #F7F7F8;
}

/* ===== 用户卡片 ===== */
.user-card {
  margin: 32rpx 40rpx 24rpx;
  background: linear-gradient(135deg, #E31E15 0%, #FF5A4A 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.user-avatar-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 6rpx solid rgba(255,255,255,0.4);
  background: rgba(255,255,255,0.2);
  margin-bottom: 20rpx;
}
.user-avatar {
  width: 100%;
  height: 100%;
}
.user-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  background: rgba(255,255,255,0.15);
}
.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}
.user-id {
  font-size: 24rpx;
  color: rgba(255,255,255,0.65);
}

/* ===== 通用卡片 ===== */
.card {
  margin: 0 40rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 32rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.card-badge {
  font-size: 26rpx;
  font-weight: 600;
  color: #E31E15;
  background: #FFF0EF;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.card-sub {
  font-size: 26rpx;
  font-weight: 600;
  color: #E31E15;
  text-align: center;
  margin-bottom: 16rpx;
  padding: 10rpx 0;
  background: #FFF0EF;
  border-radius: 12rpx;
}
.card-more {
  font-size: 26rpx;
  color: #AAAAAA;
}

/* ===== 小狮行列 ===== */
.lion-row {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}
.lion-card {
  flex: 1;
  aspect-ratio: 1;
  border-radius: 20rpx;
  background: #FAFAFA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
  transition: transform 0.2s;
}
.lion-card:active {
  transform: scale(0.96);
}
.lion-card.lion-locked {
  opacity: 0.45;
  filter: grayscale(1);
}
.lion-img {
  width: 72rpx;
  height: 72rpx;
}
.lion-emoji {
  font-size: 48rpx;
}
.lion-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #333333;
}
.lion-lock-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
}

.lion-progress {
  margin-top: 20rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #F0F0F0;
  overflow: hidden;
}
.lion-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #E31E15, #FF5A4A);
  transition: width 0.5s ease;
}

/* ===== 成就行列 ===== */
.achi-row {
  display: flex;
  gap: 16rpx;
}
.achi-card {
  flex: 1;
  padding: 28rpx 16rpx 22rpx;
  border-radius: 20rpx;
  background: #FAFAFA;
  text-align: center;
}
.achi-icon {
  font-size: 44rpx;
  display: block;
  margin-bottom: 10rpx;
}
.achi-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
}
.achi-desc {
  font-size: 20rpx;
  color: #949494;
  display: block;
  margin-top: 4rpx;
}

/* ===== 作品 ===== */
.work-row {
  display: flex;
  gap: 16rpx;
}
.work-thumb {
  flex: 1;
  aspect-ratio: 1;
  border-radius: 20rpx;
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
}
.work-thumb-icon {
  font-size: 48rpx;
  color: #CCCCCC;
}
.empty-hint {
  padding: 48rpx 0;
  text-align: center;
}
.empty-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 26rpx;
  color: #AAAAAA;
}

/* ===== 快捷菜单 ===== */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 8rpx;
}
.menu-item:active {
  opacity: 0.6;
}
.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.menu-icon {
  font-size: 40rpx;
}
.menu-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
}
.menu-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}
.menu-divider {
  height: 2rpx;
  background: #F5F5F5;
  margin: 0 8rpx;
}

.bottom-spacer {
  height: 156rpx;
}
