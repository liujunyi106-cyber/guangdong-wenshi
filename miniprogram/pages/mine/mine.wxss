/* 个人中心（对齐商店页面结构） */

.page {
  height: 100vh;
  background: #FFFFFF;
}

.page-scroll {
  height: 100vh;
}

/* ===== 用户卡片（335×142，与商店 Hero 完全一致） ===== */
/* 圆点背景（对齐商店 Hero） */
.hero-dots {
  position: absolute;
  right: 0;
  top: 22rpx;
  width: 180rpx;
  height: 138rpx;
  z-index: 1;
}
.hero-card {
  width: 670rpx;
  height: 284rpx;
  border-radius: 32rpx;
  margin: 52rpx 40rpx 24rpx;
  background: linear-gradient(90deg, #E31E15 0%, #F4725C 100%);
  position: relative;
  overflow: visible;
}
.hero-avatar-wrap {
  position: absolute;
  left: 34rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 6rpx solid rgba(255,255,255,0.4);
  background: rgba(255,255,255,0.2);
}
.hero-avatar {
  width: 100%;
  height: 100%;
}
.hero-avatar-default {
  width: 80rpx;
  height: 80rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.hero-name-wrap {
  position: absolute;
  left: 204rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  z-index: 1;
}
.hero-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}
.hero-id {
  font-size: 24rpx;
  color: rgba(255,255,255,0.65);
  line-height: 1;
}

/* ===== 下拉展开菜单 ===== */
.menu-accordion-card {
  padding: 8rpx 0;
  overflow: hidden;
}
.accordion-item {
  padding: 0 32rpx;
}
.accordion-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
}
.accordion-header:active {
  opacity: 0.6;
}
.accordion-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  transition: transform 0.25s ease;
}
.accordion-arrow.open {
  transform: rotate(90deg);
}
.accordion-body {
  padding: 0 0 28rpx;
  animation: accordionSlideIn 0.25s ease-out;
}
@keyframes accordionSlideIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 通用卡片 ===== */
.card {
  margin: 0 40rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 32rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.card-head-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  flex: 1;
}
.card-badge {
  font-size: 26rpx;
  font-weight: 600;
  color: #E31E15;
  background: #FFF0EF;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.card-sub {
  font-size: 26rpx;
  font-weight: 600;
  color: #E31E15;
  text-align: center;
  margin-bottom: 16rpx;
  padding: 10rpx 0;
  background: #FFF0EF;
  border-radius: 12rpx;
}

/* ===== 小狮行列 ===== */
.lion-row {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}
.lion-card {
  flex: 1;
  height: 200rpx;
  border-radius: 20rpx;
  background: #FAFAFA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
}
.lion-card.lion-locked {
  opacity: 0.55;
}
.lion-img {
  width: 72rpx;
  height: 72rpx;
}
.lion-emoji {
  font-size: 48rpx;
}
.lion-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #333333;
}
.lion-lock-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
}

.lion-progress {
  margin-top: 20rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #F0F0F0;
  overflow: hidden;
}
.lion-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #E31E15, #FF5A4A);
  transition: width 0.5s ease;
}

/* ===== 成就 ===== */
.achi-scroll {
  width: 100%;
  white-space: nowrap;
}
.achi-row {
  display: inline-flex;
  gap: 16rpx;
}
.achi-card {
  width: 200rpx;
  flex-shrink: 0;
  padding: 28rpx 16rpx 22rpx;
  border-radius: 20rpx;
  background: #FAFAFA;
  text-align: center;
  position: relative;
}
.achi-card.achi-locked {
  opacity: 1;
  background: #E0E0E0;
}
.achi-icon-img {
  width: 64rpx;
  height: 64rpx;
  display: block;
  margin: 0 auto 10rpx;
}
.achi-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
}
.achi-desc {
  font-size: 20rpx;
  color: #949494;
  display: block;
  margin-top: 4rpx;
}

/* ===== 作品 ===== */
.work-row {
  display: flex;
  gap: 16rpx;
}
.work-thumb {
  flex: 1;
  aspect-ratio: 1;
  border-radius: 20rpx;
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
}
.work-thumb-icon {
  font-size: 48rpx;
  color: #CCCCCC;
}
.work-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}
.empty-hint {
  padding: 48rpx 0;
  text-align: center;
}
.empty-text {
  font-size: 26rpx;
  color: #AAAAAA;
}

/* ===== 快捷菜单 ===== */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 8rpx;
}
.menu-item:active {
  opacity: 0.6;
}
.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.menu-icon-img {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.menu-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.menu-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}
.menu-divider {
  height: 2rpx;
  background: #F5F5F5;
  margin: 0 8rpx;
}

.bottom-spacer {
  height: 156rpx;
}

/* ===== 详情页 ===== */
.detail-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.back-text-btn {
  font-size: 32rpx;
  color: #E31E15;
  font-weight: 600;
  line-height: 1;
}
.back-text-btn:active {
  opacity: 0.6;
}

.record-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.record-item:last-child {
  border-bottom: none;
}
.record-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.record-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.record-rating {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.record-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #E31E15;
}
.record-stats {
  display: flex;
  gap: 12rpx;
}
.stat {
  font-size: 22rpx;
  font-weight: 400;
  color: #AAAAAA;
}
.stat-num {
  font-size: 22rpx;
  font-weight: 400;
  color: #999999;
  margin-left: 2rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-thumb {
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  background: #FAFAFA;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.photo-thumb-emoji {
  font-size: 56rpx;
}
.photo-thumb-name {
  font-size: 22rpx;
  color: #949494;
}
