/* 故事详情页（对齐 Figma node 110:26 + 装饰星标） */

.page {
  min-height: 100vh;
  background: #FFFFFF;
}
.page-scroll {
  height: 100vh;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 40rpx;
  flex-shrink: 0;
  background: #FFFFFF;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.nav-back-arrow {
  font-size: 36rpx;
  color: #AAAAAA;
  line-height: 1;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #252525;
}
.nav-spacer {
  width: 64rpx;
  flex-shrink: 0;
}

/* Hero 图片 */
.hero-img {
  width: 750rpx;
  height: 514rpx;
  display: block;
}

/* 内容卡片 — 与 Hero 重叠 */
.content-card {
  width: 750rpx;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  margin-top: -24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* 标题区 + 装饰星标 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.header-star-l,
.header-star-r {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}
.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E1E1E;
  text-align: center;
  line-height: 1.3;
}

/* 正文区 — 标签+内容 */
.card-body {
  margin-bottom: 48rpx;
}
.section-block {
  margin-bottom: 36rpx;
}
.section-tag {
  display: inline-block;
  background: linear-gradient(135deg, #E31E15 0%, #F4725C 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  line-height: 1.4;
}
.section-text {
  display: block;
  font-size: 30rpx;
  color: #333333;
  line-height: 2;
}

/* 知识点小结 */
.card-highlights {
  background: #FFFBF5;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid #F5E6C8;
}
.highlights-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.hl-icon {
  width: 32rpx;
  height: 32rpx;
}
.hl-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #C5983A;
}
.highlights-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.hl-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.hl-dot {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}
.hl-text {
  font-size: 26rpx;
  color: #5A4A2F;
  line-height: 1.6;
  flex: 1;
}

/* 底部占位 */
.bottom-placeholder {
  height: 80rpx;
}
