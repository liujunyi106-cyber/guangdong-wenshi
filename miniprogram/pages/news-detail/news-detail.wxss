/* 故事详情页（对齐 Figma node 110:26） */

.page {
  min-height: 100vh;
  background: #FFFFFF;
}
.page-scroll {
  height: 100vh;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 40rpx;
  flex-shrink: 0;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.nav-back-arrow {
  font-size: 36rpx;
  color: #AAAAAA;
  line-height: 1;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #252525;
}
.nav-spacer {
  width: 64rpx;
  flex-shrink: 0;
}

/* Hero 图片 */
.hero-img {
  width: 750rpx;
  height: 514rpx;
  display: block;
}

/* 内容卡片 — 与 Hero 重叠 9px */
.content-card {
  width: 750rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-top: -18rpx;
  padding: 40rpx 40rpx 60rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}
.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
  line-height: 1.4;
  margin-bottom: 24rpx;
}
.card-body {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  white-space: pre-line;
}

/* 底部占位 */
.bottom-placeholder {
  height: 80rpx;
}
