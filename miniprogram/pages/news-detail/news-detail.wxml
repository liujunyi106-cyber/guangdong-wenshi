<!-- 故事详情页 -->
<view class="page">
  <!-- 状态栏 -->
  <view class="status-bar" style="height:{{statusBarHeight}}px; padding-top:{{statusBarPadding}}px;"></view>

  <scroll-view scroll-y class="page-scroll" style="padding-top:{{statusBarHeight}}px;">

    <!-- 导航栏 -->
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-arrow">←</text>
      </view>
      <text class="nav-title">故事详情</text>
      <view class="nav-spacer"></view>
    </view>

    <!-- Hero 图片 -->
    <image class="hero-img" src="{{newsData.image}}" mode="aspectFill"></image>

    <!-- 内容卡片 -->
    <view class="content-card">
      <!-- 标题区 + 装饰星标 -->
      <view class="card-header">
        <image class="header-star-l" src="/images/deco-star-1.png" mode="aspectFit"></image>
        <text class="card-title">{{newsData.title}}</text>
        <image class="header-star-r" src="/images/deco-star-3.png" mode="aspectFit"></image>
      </view>

      <!-- 装饰分割线 -->
      <view class="card-divider">
        <image class="divider-star" src="/images/icon-star-filled.png" mode="aspectFit"></image>
        <view class="divider-line"></view>
        <image class="divider-star" src="/images/icon-star-filled.png" mode="aspectFit"></image>
      </view>

      <!-- 正文区 — 标签+内容 -->
      <view class="card-body">
        <view class="section-block" wx:for="{{newsData.sections}}" wx:key="index">
          <view class="section-tag">{{item.tag}}</view>
          <text class="section-text">{{item.body}}</text>
        </view>
      </view>

      <!-- 知识点小结 -->
      <view class="card-highlights" wx:if="{{newsData.highlights.length > 0}}">
        <view class="highlights-hd">
          <image class="hl-icon" src="/images/icon-star-filled.png" mode="aspectFit"></image>
          <text class="hl-title">要点速览</text>
        </view>
        <view class="highlights-list">
          <view class="hl-item" wx:for="{{newsData.highlights}}" wx:key="index" wx:for-item="h">
            <image class="hl-dot" src="/images/deco-star-4.png" mode="aspectFit"></image>
            <text class="hl-text">{{h}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-placeholder"></view>

  </scroll-view>
</view>
