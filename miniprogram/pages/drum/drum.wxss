/* 敲鼓页面样式（对齐 design-spec.md V2.7 §5.8 + §5.9） */

.page {
  width: 100%;
  height: 100vh;
  background: #FFFFFF;
  overflow: hidden;
}

.page-state {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.page-state.game-page {
  overflow: visible;
}
.page-state.result-wrap {
  align-items: center;
  justify-content: center;
}

/* 曲目选择页标题——对齐首页"小狮子"居中 */
.sub-header {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  height: 112rpx;
  gap: 24rpx;
  flex-shrink: 0;
}
.sub-title {
  flex: 1;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #000000;
  padding: 4rpx 0 16rpx;
}
.sub-spacer {
  width: 64rpx;
  flex-shrink: 0;
}

/* 曲目卡片 */
.song-card {
  width: 670rpx;
  height: 200rpx;
  background: #F36F59;
  border-radius: 32rpx;
  margin: 0 auto 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.song-card:active {
  transform: scale(0.97);
  opacity: 0.85;
}
.song-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
}
.song-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  display: block;
  margin-top: 8rpx;
}
.song-right {
  text-align: center;
}
.song-stars {
  display: flex;
  gap: 4rpx;
  justify-content: center;
}
.star-icon {
  width: 36rpx;
  height: 36rpx;
}
.song-best {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  display: block;
  margin-top: 4rpx;
}
.lion-status {
  margin: 32rpx 40rpx;
  padding: 32rpx;
  background: #FFF5F3;
  border-radius: 24rpx;
}
.lion-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
}
.lion-row + .lion-row {
  margin-top: 20rpx;
}
.lion-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.lion-thumb {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
}
.unlocked {
  color: #333333;
  font-weight: 500;
}
.locked {
  color: #AAAAAA;
}

/* ===== 倒计时页 ===== */
.cd-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  z-index: 10;
}

/* 标题 —— 与数字同一套绝对居中方案 */
.cd-title-abs {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-family: "MiSans Latin", "PingFang SC", sans-serif;
  font-size: 40rpx;
  font-weight: 600;
  color: #000000;
}

/* 数字 */
.cd-number-box {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  text-align: center;
  transform: translateY(-50%);
}
.cd-number {
  display: inline-block;
  font-family: "MiSans Latin", "PingFang SC", sans-serif;
  font-size: 240rpx;
  font-weight: 700;
  color: #E31E15;
  line-height: 1;
  white-space: nowrap;
}
.cd-number.cd-pulse {
  animation: cdPulse 0.6s ease-in-out;
}
@keyframes cdPulse {
  0% { transform: scale(0.8); opacity: 0.4; }
  50% { transform: scale(1.12); opacity: 1; }
  100% { transform: scale(1); opacity: 0.8; }
}

/* 游戏头部 */
.game-header {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  height: 112rpx;
  gap: 24rpx;
  flex-shrink: 0;
  margin-top: 10px;
}
.game-progress-wrap {
  flex: 1;
  height: 16rpx;
  background: #EEEEEE;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 24rpx;
}
.game-progress-fill {
  height: 100%;
  width: 0%;
  background: #E31E15;
  border-radius: 8rpx;
  transition: width 0.3s;
}
.progress-pct {
  font-size: 24rpx;
  font-weight: 600;
  color: #666666;
  min-width: 80rpx;
  text-align: right;
}

/* 游戏主体 */
.game-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}
/* IP动作图（游戏中根据表现动态切换） */
.game-ip-img {
  width: 240rpx;
  height: 240rpx;
  margin: 34rpx auto 0;
  flex-shrink: 0;
  display: block;
}

/* 鼓面区域 */
.drum-stage {
  width: 750rpx;
  flex: 1;
  position: relative;
  overflow: visible;
  min-height: 400rpx;
}
/* 鼓面 + 命中区共用容器 —— 对齐鼓面位置 */
.drum-container {
  position: absolute;
  bottom: 132rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 680rpx;
  height: 680rpx;
}
.drum-area {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

/* 虚幻鼓棒（CSS 绘制，参照 HTML 原型） */
.drumstick {
  position: absolute;
  width: 320rpx;
  height: 28rpx;
  pointer-events: none;
  z-index: 8;
  opacity: 0;
}
/* 外形：半透明边框 + 淡内部 */
.drumstick::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 14rpx;
  border: 6rpx solid #CCCCCC;
  background: transparent;
}
.drumstick::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 40rpx;
  right: 40rpx;
  bottom: 6rpx;
  background: rgba(180,180,180,0.1);
  border-radius: 8rpx;
}

/* 中心击打位置 */
.drumstick-center.drumstick-l {
  left: -160rpx;
  top: 200rpx;
  transform: rotate(-25deg);
}
.drumstick-center.drumstick-r {
  right: -160rpx;
  top: 200rpx;
  transform: rotate(25deg);
}
/* 边缘击打位置 */
.drumstick-rim.drumstick-l {
  left: -200rpx;
  top: 120rpx;
  transform: rotate(-45deg);
}
.drumstick-rim.drumstick-r {
  right: -200rpx;
  top: 120rpx;
  transform: rotate(45deg);
}

.drumstick-show {
  animation: drumstickFly 0.4s ease-out forwards;
}

@keyframes drumstickFly {
  0% { opacity: 0.8; }
  50% { opacity: 1; }
  100% { opacity: 0; }
}

/* 命中区标记 */
.hit-zone {
  position: absolute;
  pointer-events: none;
  opacity: 0;
  z-index: 5;
  transition: opacity 0.15s;
}
.hit-zone.hz-active {
  opacity: 1;
  animation: zoneGlow 0.6s ease-in-out infinite alternate;
}
@keyframes zoneGlow {
  0% { background: rgba(227,30,21,0.15); border-color: rgba(227,30,21,0.6); box-shadow: 0 0 24rpx rgba(227,30,21,0.3); }
  100% { background: rgba(227,30,21,0.35); border-color: rgba(227,30,21,1); box-shadow: 0 0 64rpx rgba(227,30,21,0.6); }
}
.hz-left {
  left: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 100rpx;
  height: 100rpx;
  border: 4rpx solid rgba(227,30,21,0.6);
  border-radius: 50%;
  background: rgba(227,30,21,0.1);
}
.hz-right {
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 100rpx;
  height: 100rpx;
  border: 4rpx solid rgba(227,30,21,0.6);
  border-radius: 50%;
  background: rgba(227,30,21,0.1);
}
.hz-center {
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 160rpx;
  border: 4rpx solid rgba(227,30,21,0.6);
  border-radius: 50%;
  background: rgba(227,30,21,0.1);
}
.hz-rim-left {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 112rpx;
  border: 4rpx solid rgba(227,30,21,0.6);
  border-radius: 12rpx;
  background: rgba(227,30,21,0.1);
}
.hz-rim-right {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 112rpx;
  border: 4rpx solid rgba(227,30,21,0.6);
  border-radius: 12rpx;
  background: rgba(227,30,21,0.1);
}

/* 判定文字 */
.judge-text {
  position: absolute;
  font-size: 52rpx;
  font-weight: 700;
  pointer-events: none;
  opacity: 0;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 6;
}
.judge-text.perfect { color: #D9A441; }
.judge-text.good { color: #FFFFFF; }
.judge-text.miss { color: #999999; }
.judge-text.judge-flash {
  animation: judgePop 0.8s ease-out forwards;
}
@keyframes judgePop {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(0.5); }
  30% { opacity: 1; transform: translate(-50%, -50%) scale(1.3); }
  100% { opacity: 0; transform: translate(-50%, -160%) scale(1); }
}

/* 拍点提示 */
.beat-hint {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 7;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
}
.beat-hint.beat-hint-show {
  opacity: 1;
}

/* 结算 */
.result-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0 80rpx;
  overflow-y: auto;
}
.result-ip-img {
  width: 360rpx;
  height: 360rpx;
  flex-shrink: 0;
  margin-bottom: 32rpx;
}
.result-stars {
  font-size: 72rpx;
  letter-spacing: 12rpx;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}
.result-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #E31E15;
  margin-bottom: 12rpx;
  flex-shrink: 0;
  text-align: center;
  padding: 0 40rpx;
}
.result-detail {
  font-size: 28rpx;
  color: #E31E15;
  margin-bottom: 48rpx;
  text-align: center;
  line-height: 1.8;
  flex-shrink: 0;
  padding: 0 40rpx;
}
.result-actions {
  display: flex;
  gap: 32rpx;
  flex-shrink: 0;
}
.result-btn {
  width: 260rpx;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: 2px solid #DDDDDD;
  background: #FFFFFF;
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: center;
}
.result-btn:active {
  background: #f0f0f0;
}
.retry-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
}
.result-btn-home {
  background: #333333;
  color: #FFFFFF;
  border-color: #333333;
}

/* Toast */
.toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #333333;
  color: #FFFFFF;
  font-size: 26rpx;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  z-index: 200;
}
