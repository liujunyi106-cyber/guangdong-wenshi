<!-- 首页 · 小狮子 -->
<view class="page">
  <!-- 状态栏 -->
  <view class="status-bar" style="height:{{statusBarHeight}}px; padding-top:{{statusBarPadding}}px;"></view>

  <!-- 可滚动内容区 -->
  <scroll-view scroll-y class="page-scroll" style="padding-top:{{statusBarHeight}}px;">

    <!-- 页面标题区（与曲目选择页 sub-header 同高对齐） -->
    <view class="sub-header">
      <view class="sub-spacer"></view>
      <text class="sub-title">小狮子</text>
      <view class="sub-spacer"></view>
    </view>

    <!-- Hero 卡片 -->
    <view class="hero-card" bindtap="onHeroTap">
      <image class="hero-dots-bg" src="/images/hero-dots.svg" mode="aspectFit"></image>
      <view class="hero-hello">Hello</view>
      <view class="hero-exclaim">!</view>
      <view class="hero-title">一起来敲鼓</view>
      <view class="hero-mode">做游戏吧</view>
      <image class="hero-lion" src="/images/hero-lion.png" mode="aspectFit"></image>
      <view class="hero-cta">
        <text class="hero-cta-text">快来一起来敲鼓吧</text>
        <image class="hero-cta-play-img" src="/images/btn-play.svg" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 次级功能卡片行 -->
    <view class="secondary-row">
      <view class="secondary-card" style="background:#F36F59;" bindtap="onARTap">
        <view class="sc-title">狮子拍照</view>
        <view class="sc-sub">快来一起拍照吧</view>
        <image class="sc-dots" src="/images/card-ar-dots.svg" mode="aspectFit"></image>
        <image class="sc-icon ar-icon" src="/images/icon-ar.png" mode="aspectFit"></image>
      </view>
      <view class="secondary-card" style="background:#F36F59;" bindtap="onColorTap">
        <view class="sc-title">狮子绘画</view>
        <view class="sc-sub">画你的专属狮子吧</view>
        <image class="sc-dots" src="/images/card-ar-dots.svg" mode="aspectFit"></image>
        <image class="sc-icon color-icon" src="/images/icon-color.png" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 舞狮趣闻 -->
    <view class="section-title">舞狮趣闻</view>
    <view class="news-grid">
      <!-- 左列 -->
      <view class="news-col">
        <view class="news-card" bindtap="onNewsTap" data-id="secret">
          <image class="news-img" src="/images/card-news-secret.png" mode="aspectFill"></image>
          <view class="news-info">
            <text class="news-title">狮头颜色小秘密</text>
            <text class="news-desc">为什么狮头会有各种不同的颜色？</text>
          </view>
        </view>
        <view class="news-card" bindtap="onNewsTap" data-id="liubei">
          <image class="news-img" src="/images/card-news-liubei.jpg" mode="aspectFill"></image>
          <view class="news-info">
            <text class="news-title">刘备狮是谁</text>
            <text class="news-desc">温和又稳重的小狮</text>
          </view>
        </view>
      </view>
      <!-- 右列 -->
      <view class="news-col">
        <view class="news-card" bindtap="onNewsTap" data-id="caiqing">
          <image class="news-img" src="/images/card-news-caiqing.jpg" mode="aspectFill"></image>
          <view class="news-info">
            <text class="news-title">小狮怎么采青</text>
            <text class="news-desc">跳一跳摘好运</text>
          </view>
        </view>
        <view class="news-card news-card-placeholder">
          <view class="news-info">
            <text class="news-title">待开发中</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部导航占位 -->
    <view class="bottom-nav-placeholder"></view>
  </scroll-view>
</view>
