/* 涂色装饰样式 */
.page {
  width: 100%;
  min-height: 100vh;
  background: #FFFFFF;
}
.state-show {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 子页面头部 */
.sub-header {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  height: 112rpx;
  flex-shrink: 0;
}
.sub-title {
  flex: 1;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #000000;
}
.sub-spacer {
  width: 64rpx;
  flex-shrink: 0;
}
.edit-header {
  justify-content: space-between;
}
.edit-header .mode-tabs {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

/* 线稿选择 - IP 形象网格 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #000000;
  padding: 24rpx 40rpx 12rpx;
}
.ip-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 30rpx;
  padding: 32rpx 40rpx;
  flex: 1;
  overflow-y: auto;
  align-content: flex-start;
}
.sticker-card {
  width: 320rpx;
  height: 242rpx;
  border-radius: 32rpx;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-sizing: border-box;
  border: 4rpx solid transparent;
}
.sticker-card:active {
  transform: scale(0.95);
}
.sticker-card.sticker-selected {
  border-color: #E31E15;
  background: #FFF5F3;
}
.sticker-img {
  width: 140rpx;
  height: 140rpx;
}
.sticker-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}
.outline-start {
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #E31E15;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 模式标签 */
.mode-tabs {
  display: flex;
  gap: 32rpx;
  align-items: center;
}
.mode-tab {
  font-size: 36rpx;
  color: #AAAAAA;
  padding: 8rpx 0;
}
.mode-tab.mode-active {
  color: #E31E15;
  font-weight: 700;
  border-bottom: 4rpx solid #E31E15;
}

/* 涂色画布 */
.color-canvas {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.canvas-area {
  flex: 1;
  margin: 0 40rpx;
  border-radius: 32rpx;
  overflow: hidden;
  position: relative;
  min-height: 600rpx;
  background: #FFFFFF;
  border: 2px dashed #D9D9D9;
}
.touch-layer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 10;
}
.ip-ref-wrap {
  position: absolute;
  z-index: 20;
}
.ip-ref-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  border: 4rpx solid #E31E15;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.18);
}
.ip-drag-handle {
  position: absolute;
  right: -16rpx;
  bottom: -16rpx;
  width: 48rpx;
  height: 48rpx;
  background: #E31E15;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}
.paint-canvas {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0; left: 0;
}

/* 操作用上下间距 */
.color-actions {
  display: flex;
  gap: 24rpx;
  padding: 32rpx 40rpx;
  flex-shrink: 0;
}

/* 画笔粗细（对齐 AR 编辑页 ctrl-row 样式） */
.brush-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 40rpx 12rpx;
  flex-shrink: 0;
}
.brush-end {
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}
.brush-bar slider {
  flex: 1;
}

/* 橡皮擦大小（右侧滑块，cover-view 覆盖原生 canvas） */
.eraser-size-bar {
  position: fixed;
  right: 8rpx;
  width: 64rpx;
  height: 440rpx;
  z-index: 999;
}
.eraser-end-text {
  width: 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  line-height: 40rpx;
  height: 40rpx;
}
.eraser-track {
  width: 40rpx;
  height: 344rpx;
  margin-left: 12rpx;
  background: #E8E8E8;
  border-radius: 8rpx;
  position: relative;
}
.eraser-fill {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 40rpx;
  background: #999999;
}
.eraser-thumb {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  background: #999999;
  border-radius: 50%;
  left: 2rpx;
}

/* 调色盘 - 横向滑动，上下居中 */
.palette {
  width: 100%;
  padding: 32rpx 0;
  flex-shrink: 0;
}
.palette-scroll {
  width: 100%;
  white-space: nowrap;
}
.palette-row {
  display: inline-flex;
  gap: 24rpx;
  padding: 0 40rpx;
}
.color-swatch {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  flex-shrink: 0;
  transition: border-color 0.15s, box-shadow 0.15s;
}
.color-swatch.swatch-active {
  /* 选中态边框/阴影由 WXML 内联 style 控制 */
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border: 2px solid #DDDDDD;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333333;
  background: #FFFFFF;
}
.action-icon {
  width: 44rpx;
  height: 44rpx;
}
.action-btn.eraser-active {
  border-color: #E31E15;
  background: #FFF5F3;
}
.action-btn:active {
  background: #F0F0F0;
}
.action-btn.action-save {
  background: #E31E15;
  border-color: #E31E15;
  color: #FFFFFF;
}

/* 装饰 */
.deco-area {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.deco-canvas {
  min-height: 500rpx;
}
/* 装饰拖拽预览 */
.deco-ghost {
  position: absolute;
  width: 100px;
  height: 100px;
  z-index: 40;
  opacity: 0.7;
  pointer-events: none;
}
.deco-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: #F5F5F5;
  flex-shrink: 0;
  border: 4rpx solid transparent;
}
.deco-thumb.deco-selected {
  border-color: #E31E15;
  background: #FFF5F3;
}

/* 确认弹窗 */
.confirm-dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 32rpx;
  z-index: 102;
  text-align: center;
}
.confirm-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
  display: block;
}
.confirm-sub {
  font-size: 24rpx;
  color: #94A3B8;
  display: block;
  margin-top: 12rpx;
}
.confirm-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}
.confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.confirm-cancel {
  background: #F5F5F5;
  color: #AAAAAA;
}
.confirm-ok {
  background: #E31E15;
  color: #FFFFFF;
}

/* 保存完成页 */
.done-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.done-check {
  font-size: 48rpx;
  color: #34C759;
  margin-bottom: 40rpx;
}
.done-preview {
  width: 600rpx;
  height: 600rpx;
  border-radius: 32rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 48rpx;
}
.done-img {
  width: 100%;
  height: 100%;
}
.done-actions {
  display: flex;
  gap: 32rpx;
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
}
.done-actions .btn-outline {
  flex: 1;
  height: 96rpx;
  border-radius: 16rpx;
  border: 2px solid #DDDDDD;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  background: #FFFFFF;
}
.done-actions .btn-outline:active {
  background: #F0F0F0;
}
.done-actions .btn-primary {
  flex: 1;
  height: 96rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #E31E15;
  width: auto;
}
.done-actions .btn-primary:active {
  opacity: 0.85;
}
.done-hint {
  font-size: 24rpx;
  color: #AAAAAA;
  text-align: center;
  margin-top: 32rpx;
}

/* 解锁弹窗（对齐鼓页款式） */
.unlock-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: unlockFadeIn 0.3s ease-out;
}
@keyframes unlockFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.unlock-card {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 64rpx 48rpx 48rpx;
  text-align: center;
  animation: unlockBounce 0.4s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes unlockBounce {
  0% { transform: scale(0.7); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.unlock-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 24rpx;
}
.unlock-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #E31E15;
  display: block;
  margin-bottom: 16rpx;
}
.unlock-sub {
  font-size: 28rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 40rpx;
}
.unlock-btn {
  width: 320rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #E31E15;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}
