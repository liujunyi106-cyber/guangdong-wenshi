<!-- AR拍照页面 -->
<view class="page">
  <!-- 状态栏 -->
  <view class="status-bar" style="height:{{statusBarHeight}}px; padding-top:{{statusBarPadding}}px;"></view>

  <!-- ===== 相机取景页 ===== -->
  <view class="state {{state==='camera' ? 'state-show' : ''}}">
    <view class="camera-preview" style="padding-top:{{statusBarHeight}}px;">
      <view class="camera-placeholder">
        <image class="icon-placeholder" src="/images/sticker.png" mode="aspectFit" wx:if="{{false}}"></image>
        <text class="camera-hint">📷 相机预览区</text>
        <text class="camera-sub">用相机给小狮子拍照吧！</text>
      </view>
    </view>
    <!-- 顶部栏 -->
    <view class="ar-top-bar" style="top:{{statusBarHeight}}px;">
      <view class="back-btn back-btn-dark" bindtap="goBack">←</view>
      <text class="ar-top-title">狮子拍照</text>
    </view>
    <!-- 底部快门 -->
    <view class="shutter-bar">
      <view class="shutter-side" bindtap="onAlbum">
        <image class="shutter-side-icon shutter-album-icon" src="/images/icon-album.png" mode="aspectFit"></image>
        <text class="shutter-side-label">相册</text>
      </view>
      <view class="shutter-btn" bindtap="onShutter">
        <view class="shutter-inner"></view>
      </view>
      <view class="shutter-side" bindtap="onFlip">
        <image class="shutter-side-icon" src="/images/flip-camera.png" mode="aspectFit"></image>
        <text class="shutter-side-label">翻转</text>
      </view>
    </view>
  </view>

  <!-- ===== 贴纸选择页 ===== -->
  <view class="state {{state==='sticker' ? 'state-show' : ''}}">
    <view class="sub-header" style="padding-top:{{statusBarHeight}}px;">
      <view class="back-btn" bindtap="goBack">←</view>
      <text class="sub-title">选择贴纸</text>
      <view class="sub-spacer"></view>
    </view>
    <view class="sticker-grid">
      <view class="sticker-card {{item.unlocked ? '' : 'sticker-locked'}} {{selectedSticker === item.id ? 'sticker-selected' : ''}}"
        wx:for="{{stickers}}" wx:key="id"
        bindtap="{{item.unlocked ? 'onSelectSticker' : 'onTapLocked'}}" data-id="{{item.id}}">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" class="sticker-img"></image>
        <text wx:else class="sticker-emoji">{{item.emoji}}</text>
        <text class="sticker-name">{{item.name}}</text>
        <view wx:if="{{!item.unlocked}}" class="sticker-lock">
          <image src="/images/lock.png" mode="aspectFit" class="lock-icon"></image>
        </view>
      </view>
    </view>
    <view class="sticker-bottom">
      <view class="btn-primary {{selectedSticker ? '' : 'btn-disabled'}}" bindtap="onNextEdit">下一步：编辑位置</view>
    </view>
  </view>

  <!-- ===== 贴纸编辑页 ===== -->
  <view class="state {{state==='edit' ? 'state-show' : ''}}">
    <view class="sub-header edit-header" style="padding-top:{{statusBarHeight}}px;">
      <view class="back-btn" bindtap="onBackToSticker">←</view>
      <text class="sub-title">编辑贴纸</text>
    </view>
    <view class="edit-preview">
      <view class="edit-photo">
        <text class="edit-photo-placeholder">📷 照片预览</text>
      </view>
      <view class="edit-sticker-overlay"
        style="transform: translate({{stickerX}}px, {{stickerY}}px);"
        bindtouchstart="onStickerTouchStart"
        bindtouchmove="onStickerTouchMove"
        bindtouchend="onStickerTouchEnd">
        <image wx:if="{{editStickerImage}}" src="{{editStickerImage}}" mode="aspectFit" class="edit-sticker-img"
          style="transform: scale({{stickerScale}}) rotate({{stickerRotation}}deg);"></image>
        <text wx:else class="edit-sticker-emoji">{{editStickerEmoji}}</text>
      </view>
    </view>
    <view class="edit-ctrls">
      <view class="ctrl-done" bindtap="onSaveEdit">
        <text>完成</text>
      </view>
    </view>
  </view>

  <!-- ===== 保存完成页 ===== -->
  <view class="state {{state==='done' ? 'state-show' : ''}}">
    <view class="sub-header" style="padding-top:{{statusBarHeight}}px;">
      <view class="back-btn" bindtap="goBack">←</view>
      <text class="sub-title">保存完成</text>
      <view class="sub-spacer"></view>
    </view>
    <view class="done-wrap">
      <view class="done-check"><image class="done-check-icon" src="/images/icon-saved.png" mode="aspectFit"></image><text>已保存</text></view>
      <view class="done-preview">
        <text class="done-preview-placeholder">📷 成品预览</text>
      </view>
      <view class="done-actions">
        <view class="btn-outline" bindtap="onRetake">再做一张</view>
        <view class="btn-primary" bindtap="onShare">分享好友</view>
      </view>
    </view>
  </view>

  <!-- 未解锁弹窗 -->
  <view class="modal-overlay" wx:if="{{showLockModal}}" bindtap="hideLockModal"></view>
  <view class="lock-modal" wx:if="{{showLockModal}}">
    <image class="lock-modal-icon" src="/images/3d-icons/lock.png" mode="aspectFit"></image>
    <text class="lock-modal-title">{{lockModalLion}}</text>
    <text class="lock-modal-hint">{{lockModalHint}}</text>
    <view class="lock-modal-btn" bindtap="hideLockModal">我知道了</view>
  </view>

  <!-- 解锁弹窗 -->
  <view class="unlock-overlay" wx:if="{{unlockShow}}" bindtap="dismissUnlock">
    <view class="unlock-card" catchtap="dismissUnlock">
      <image class="unlock-icon" src="/images/icon-congrats.png" mode="aspectFit"></image>
      <text class="unlock-title">{{unlockTitle}}</text>
      <text class="unlock-sub">{{unlockSub}}</text>
      <view class="unlock-btn" bindtap="dismissUnlock">太棒了</view>
    </view>
  </view>
</view>
